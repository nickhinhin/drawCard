rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function afterUserDoc(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid));
    }

    function drawDoc(drawId) {
      return get(/databases/$(database)/documents/draws/$(drawId));
    }

    function cardDoc(cardId) {
      return get(/databases/$(database)/documents/cards/$(cardId));
    }

    // Resolve the odds configured for the exact round being purchased.
    function drawRoundShareMode(drawId, roundId) {
      let draw = drawDoc(drawId).data;
      return draw.get("roundShareModes", {}).get(
        roundId,
        draw.get("shareMode", "1/2")
      );
    }

    // Cards created before per-odds pricing keep using their original token value.
    function cardPriceForShareMode(cardId, shareMode) {
      let card = cardDoc(cardId).data;
      let prices = card.get("modePrices", {});
      return shareMode == "1/10"
        ? prices.get("tenth", card.get("tokenValue", 0))
        : shareMode == "1/5"
          ? prices.get("fifth", card.get("tokenValue", 0))
          : prices.get("half", card.get("tokenValue", 0));
    }

    // Older cards without this field stay available in all three modes.
    function cardAllowsShareMode(cardId, shareMode) {
      let card = cardDoc(cardId).data;
      return !("allowedShareModes" in card)
        || shareMode in card.allowedShareModes;
    }

    function tokenRequestPath(requestId) {
      return /databases/$(database)/documents/tokenRequests/$(requestId);
    }

    function usernamePath(name) {
      return /databases/$(database)/documents/usernames/$(name.lower());
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userDoc(request.auth.uid).data.role == "admin";
    }

    function isValidUsername(name) {
      return name is string
        && name.size() >= 3
        && name.size() <= 24
        && name.matches("^[A-Za-z0-9_]+$");
    }

    function willOwnUsername(name) {
      return isValidUsername(name)
        && existsAfter(usernamePath(name))
        && getAfter(usernamePath(name)).data.uid == request.auth.uid;
    }

    function ownsUsername(name) {
      return isValidUsername(name)
        && exists(usernamePath(name))
        && get(usernamePath(name)).data.uid == request.auth.uid;
    }

    function currentUsername() {
      return userDoc(request.auth.uid).data.username;
    }

    function hasNoUsername() {
      return !("username" in userDoc(request.auth.uid).data)
        || !(userDoc(request.auth.uid).data.username is string)
        || userDoc(request.auth.uid).data.username.size() == 0;
    }

    function isReleasingCurrentUsername() {
      return isValidUsername(currentUsername())
        && !existsAfter(usernamePath(currentUsername()));
    }

    function isProfileEdit(uid) {
      return isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "username",
            "displayName",
            "photoURL",
            "phoneNumber",
            "referralCode",
            "ageConfirmed",
            "ageConfirmedAt",
            "updatedAt"
          ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["username"])
          || willOwnUsername(request.resource.data.username)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["displayName"])
          || (request.resource.data.displayName is string
            && request.resource.data.displayName.size() <= 80)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["photoURL"])
          || (request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() <= 500)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["phoneNumber"])
          || (request.resource.data.phoneNumber is string
            && request.resource.data.phoneNumber.size() <= 24)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["referralCode"])
          || (request.resource.data.referralCode is string
            && request.resource.data.referralCode.size() <= 40)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["ageConfirmed"])
          || request.resource.data.ageConfirmed == true
        );
    }

    // Bind each debit to one newly created purchase record and its exact slot.
    function isTokenSpend(uid) {
      let recordId = request.resource.data.lastPurchaseRecordId;
      let path = /databases/$(database)/documents/drawRecords/$(recordId);
      let purchase = getAfter(path).data;
      return isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["tokens", "updatedAt", "lastPurchaseRecordId"])
        && !exists(path)
        && purchase.uid == uid
        && request.resource.data.tokens is number
        && request.resource.data.tokens >= 0
        && request.resource.data.tokens == resource.data.tokens - purchase.tokenCost
        && request.resource.data.updatedAt == request.time;
    }

    // Approval and credit are reciprocal, single-use transitions after manual review.
    function isAdminTokenGrant(uid) {
      let requestId = request.resource.data.lastTokenGrantRequestId;
      let before = get(tokenRequestPath(requestId)).data;
      let after = getAfter(tokenRequestPath(requestId)).data;
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "tokens", "updatedAt", "lastTokenGrantRequestId", "totalDeposits", "vipLevel", "lastVipRewardTier"
        ])
        && before.status == "pending" && before.uid == uid
        && validTokenPricing(before) && validManualReview(before, after)
        && after.status == "approved" && after.reviewedBy == request.auth.uid
        && request.resource.data.tokens == resource.data.tokens + before.amount
        && request.resource.data.totalDeposits == resource.data.get("totalDeposits", 0) + after.verifiedHkdAmount
        && request.resource.data.vipLevel is int
        && request.resource.data.vipLevel >= -1 && request.resource.data.vipLevel <= 7;
    }

    function chatCooldownPassed() {
      return !("lastChatAt" in userDoc(request.auth.uid).data)
        || !(userDoc(request.auth.uid).data.lastChatAt is timestamp)
        || request.time >= userDoc(request.auth.uid).data.lastChatAt + duration.value(3, "s");
    }

    function isChatRateLimitUpdate(uid) {
      return isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["lastChatAt", "updatedAt"])
        && request.resource.data.lastChatAt == request.time
        && chatCooldownPassed();
    }

    // A refund requires an existing eligible award to transition in this commit.
    function isCardConversionUserEdit(uid) {
      let recordId = request.resource.data.lastConversionRecordId;
      let path = /databases/$(database)/documents/drawRecords/$(recordId);
      let before = get(path).data;
      let after = getAfter(path).data;
      return isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["tokens", "updatedAt", "lastConversionRecordId", "lastConversionAmount"])
        && conversionEligible(before)
        && before.uid == uid
        && after.uid == uid
        && after.convertedToTokens == true
        && after.collectionStatus == "converted"
        && after.convertedAt == request.time
        && after.updatedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastConversionAmount == after.tokenRefund
        && request.resource.data.lastConversionAmount > 0
        && request.resource.data.lastConversionAmount == math.floor(cardConversionRefundForRecord(before))
        && request.resource.data.tokens == resource.data.tokens + request.resource.data.lastConversionAmount;
    }

    // Historical awards without a status are pending, unless shipping has started.
    function conversionEligible(record) {
      return record.get("collectionStatus", "pending") == "pending"
        && record.get("convertedToTokens", false) == false
        && record.get("shippingRequested", false) == false
        && !("shippedAt" in record)
        && !("shippingRequestedAt" in record)
        && record.cardId is string;
    }

    function isValidSlotPurchase(drawId, roundId, slotId) {
      return signedIn()
        && ownsUsername(userDoc(request.auth.uid).data.username)
        && drawDoc(drawId).data.status == "live"
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "status",
            "purchaseRecordId",
            "uid",
            "username",
            "tokenCost",
            "targetCardId",
            "targetCardName",
            "targetCardImageUrl",
            "targetCardValue",
            "shareMode",
            "round",
            "updatedAt"
          ])
        && request.resource.data.purchaseRecordId == afterUserDoc(request.auth.uid).data.lastPurchaseRecordId
        && !exists(/databases/$(database)/documents/drawRecords/$(request.resource.data.purchaseRecordId))
        && getAfter(/databases/$(database)/documents/drawRecords/$(request.resource.data.purchaseRecordId)).data.drawId == drawId
        && getAfter(/databases/$(database)/documents/drawRecords/$(request.resource.data.purchaseRecordId)).data.round == roundId
        && getAfter(/databases/$(database)/documents/drawRecords/$(request.resource.data.purchaseRecordId)).data.slotId == slotId
        && request.resource.data.round == roundId
        && resource.data.status == "available"
        && request.resource.data.status == "locked"
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == userDoc(request.auth.uid).data.username
        && request.resource.data.number == resource.data.number
        && (!("round" in resource.data) || request.resource.data.round == resource.data.round)
        && get(
          /databases/$(database)/documents/draws/$(drawId)/rounds/$(roundId)
        ).data.roundNumber >= drawDoc(drawId).data.currentRound
        && (
          !("buyingBlockedRounds" in drawDoc(drawId).data)
          || !(request.resource.data.round in drawDoc(drawId).data.buyingBlockedRounds)
        )
        && (
          !("buyingBlockedRound" in drawDoc(drawId).data)
          || drawDoc(drawId).data.buyingBlockedRound != request.resource.data.round
        )
        && request.resource.data.targetCardId in drawDoc(drawId).data.poolCardIds
        && request.resource.data.targetCardName is string
        && request.resource.data.targetCardImageUrl is string
        && request.resource.data.shareMode in ["1/2", "1/5", "1/10"]
        && request.resource.data.shareMode == drawRoundShareMode(drawId, roundId)
        && exists(/databases/$(database)/documents/cards/$(request.resource.data.targetCardId))
        && cardAllowsShareMode(request.resource.data.targetCardId, request.resource.data.shareMode)
        && request.resource.data.tokenCost is number
        && request.resource.data.tokenCost > 0
        && request.resource.data.targetCardValue == request.resource.data.tokenCost
        && (
          (
            request.resource.data.shareMode == "1/2"
            && "poolCardValues" in drawDoc(drawId).data
            && request.resource.data.targetCardId in drawDoc(drawId).data.poolCardValues
            && request.resource.data.tokenCost == drawDoc(drawId).data.poolCardValues[request.resource.data.targetCardId]
          )
          || (
            exists(/databases/$(database)/documents/cards/$(request.resource.data.targetCardId))
            && request.resource.data.tokenCost == cardPriceForShareMode(
              request.resource.data.targetCardId,
              request.resource.data.shareMode
            )
          )
        )
        && userDoc(request.auth.uid).data.tokens >= request.resource.data.tokenCost
        && afterUserDoc(request.auth.uid).data.tokens ==
          userDoc(request.auth.uid).data.tokens - request.resource.data.tokenCost;
    }

    // Players may create only purchase metadata, never award or fulfillment fields.
    function isMatchingRoundDrawRecord(recordId) {
      let data = request.resource.data;
      let path = /databases/$(database)/documents/draws/$(data.drawId)/rounds/$(data.round)/slots/$(data.slotId);
      let slot = getAfter(path).data;
      return signedIn()
        && data.keys().hasOnly([
          "uid", "username", "drawId", "drawTitle", "roomSlug", "roomLink",
          "round", "roundSort", "slotId", "number", "tokenCost", "targetCardId",
          "targetCardName", "targetCardImageUrl", "targetCardValue", "shareMode", "createdAt"
        ])
        && data.uid == request.auth.uid
        && data.slotId is string
        && get(path).data.status == "available"
        && slot.status == "locked"
        && slot.purchaseRecordId == recordId
        && afterUserDoc(request.auth.uid).data.lastPurchaseRecordId == recordId
        && slot.uid == data.uid
        && slot.username == data.username
        && slot.number == data.number
        && slot.tokenCost == data.tokenCost
        && slot.targetCardId == data.targetCardId
        && slot.targetCardName == data.targetCardName
        && slot.targetCardImageUrl == data.targetCardImageUrl
        && slot.targetCardValue == data.targetCardValue
        && slot.shareMode == data.shareMode
        && data.createdAt == request.time;
    }

    function cardConversionAmount() {
      return resource.data.get("cardValue", null) is number
        ? resource.data.cardValue
        : resource.data.tokenCost;
    }

    function cardConversionAmountForRecord(recordData) {
      return recordData.get("cardValue", null) is number
        ? recordData.cardValue
        : recordData.tokenCost;
    }

    function cardConversionRefundForRecord(recordData) {
      return recordData.get("cardConversionValue", null) is number
        ? recordData.cardConversionValue
        : cardConversionAmountForRecord(recordData) * 0.8;
    }

    function cardConversionRefund() {
      return resource.data.get("cardConversionValue", null) is number
        ? resource.data.cardConversionValue
        : cardConversionAmount() * 0.8;
    }

    function isCardTokenConversion(recordId) {
      return signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.cardId is string
        && conversionEligible(resource.data)
        && afterUserDoc(request.auth.uid).data.lastConversionRecordId == recordId
        && afterUserDoc(request.auth.uid).data.lastConversionAmount == request.resource.data.tokenRefund
        && afterUserDoc(request.auth.uid).data.tokens == userDoc(request.auth.uid).data.tokens + request.resource.data.tokenRefund
        && cardConversionAmount() is number
        && cardConversionAmount() > 0
        && (!("convertedToTokens" in resource.data) || resource.data.convertedToTokens != true)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "collectionStatus",
            "convertedToTokens",
            "convertedAt",
            "tokenRefund",
            "updatedAt"
          ])
        && request.resource.data.collectionStatus == "converted"
        && request.resource.data.convertedToTokens == true
        && request.resource.data.tokenRefund is number
        && request.resource.data.tokenRefund <= cardConversionRefund()
        && request.resource.data.tokenRefund > cardConversionRefund() - 1
        && request.resource.data.convertedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isShippingRequest() {
      return signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.cardId is string
        && (!("convertedToTokens" in resource.data) || resource.data.convertedToTokens != true)
        && (resource.data.collectionStatus == "pending" || !("collectionStatus" in resource.data))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "collectionStatus",
            "shippingRequested",
            "shippingRecipient",
            "shippingPhone",
            "shippingMethod",
            "shippingAddress",
            "shippingNote",
            "shippingRequestedAt",
            "updatedAt"
          ])
        && request.resource.data.collectionStatus == "shipping"
        && request.resource.data.shippingRequested == true
        && request.resource.data.shippingRecipient is string
        && request.resource.data.shippingRecipient.size() > 0
        && request.resource.data.shippingRecipient.size() <= 80
        && request.resource.data.shippingPhone is string
        && request.resource.data.shippingPhone.size() > 0
        && request.resource.data.shippingPhone.size() <= 30
        && request.resource.data.shippingMethod is string
        && request.resource.data.shippingMethod in ["sf-door", "sf-pickup"]
        && request.resource.data.shippingAddress is string
        && request.resource.data.shippingAddress.size() > 0
        && request.resource.data.shippingAddress.size() <= 500
        && request.resource.data.shippingNote is string
        && request.resource.data.shippingNote.size() <= 500
        && request.resource.data.shippingRequestedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidRoomMessage(drawId) {
      return signedIn()
        && ownsUsername(userDoc(request.auth.uid).data.username)
        && drawDoc(drawId).data.status == "live"
        && chatCooldownPassed()
        && afterUserDoc(request.auth.uid).data.lastChatAt == request.time
        && request.resource.data.keys().hasOnly([
          "drawId",
          "source",
          "uid",
          "username",
          "text",
          "createdAt"
        ])
        && request.resource.data.drawId == drawId
        && request.resource.data.source == "draw"
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == userDoc(request.auth.uid).data.username
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
    }

    function isSafeStorageProofUrl(url, uid) {
      return url is string
        && url.size() > 0
        && url.size() <= 4000
        && (
          url.matches("https://firebasestorage\\.googleapis\\.com/v0/b/[^/]+/o/token-proofs%2F" + uid + "%2F[^\\s?#]+(\\?[^\\s]*)?")
          || url.matches("https://[a-z0-9.-]+\\.firebasestorage\\.app/v0/b/[^/]+/o/token-proofs%2F" + uid + "%2F[^\\s?#]+(\\?[^\\s]*)?")
        );
    }

    // Preset rates come from protected settings; custom rates use the published tiers.
    function validTokenPricing(data) {
      let settingsPath = /databases/$(database)/documents/settings/tokenPackages;
      let settings = exists(settingsPath) ? get(settingsPath).data : {};
      let packages = settings.get("packages", [
        {"hkd": 500, "tokens": 525}, {"hkd": 1000, "tokens": 1050},
        {"hkd": 3000, "tokens": 3240}, {"hkd": 10000, "tokens": 11000},
        {"hkd": 30000, "tokens": 35100}
      ]);
      let rateVersion = settings.get("rateVersion", exists(settingsPath) ? 1 : 2);
      let rate = data.hkdAmount >= 30000 ? 1.17 : data.hkdAmount >= 10000 ? 1.1 : data.hkdAmount >= 3000 ? 1.08 : 1.05;
      return data.hkdAmount is int && data.hkdAmount >= 500 && data.hkdAmount <= 1000000
        && data.amount is int && data.amount > 0 && data.amount <= 1000000
        && data.exchangeRate == float(data.amount) / data.hkdAmount
        && (
          (data.packageType == "custom" && data.amount == math.floor(data.hkdAmount * rate))
          || (data.packageType == "preset" && (
            (rateVersion >= 2 && {"hkd": data.hkdAmount, "tokens": data.amount} in packages)
            || (rateVersion < 2 && (
              {"hkd": data.hkdAmount, "tokens": data.amount * 2} in packages
              || {"hkd": data.hkdAmount, "tokens": data.amount * 2 - 1} in packages
            ))
          ))
        );
    }

    // A reviewed promotion is a grant, not a bank deposit or VIP deposit credit.
    function validManualReview(before, after) {
      return (before.proofMode == "storage" && after.verifiedHkdAmount == before.hkdAmount)
        || (before.proofMode == "promo" && before.promoCode is string
          && before.promoCode.size() > 0 && after.promoReviewed == true
          && after.verifiedHkdAmount == 0);
    }

    function isValidTokenRequestCreate() {
      return signedIn()
        && ownsUsername(userDoc(request.auth.uid).data.username)
        && request.resource.data.keys().hasOnly([
          "uid",
          "username",
          "email",
          "amount",
          "hkdAmount",
          "exchangeRate",
          "packageType",
          "fpsIdentifier",
          "fpsName",
          "proofMode",
          "proofPath",
          "proofFileName",
          "proofUrl",
          "status",
          "adminNote",
          "promoCode",
          "createdAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == userDoc(request.auth.uid).data.username
        && request.resource.data.email == userDoc(request.auth.uid).data.email
        && validTokenPricing(request.resource.data)
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.status == "pending"
        && request.resource.data.adminNote == ""
        && request.resource.data.promoCode is string
        && request.resource.data.promoCode.size() <= 80
        && (
          (
            request.resource.data.proofMode == "storage"
            && request.resource.data.proofPath is string
            && request.resource.data.proofPath.matches("token-proofs/" + request.auth.uid + "/[^/]+")
            && request.resource.data.proofFileName is string
            && request.resource.data.proofFileName.size() > 0
            && request.resource.data.proofFileName.size() <= 200
            && isSafeStorageProofUrl(request.resource.data.proofUrl, request.auth.uid)
          )
          || (request.resource.data.proofMode == "promo"
            && request.resource.data.promoCode.size() > 0
            && request.resource.data.proofPath == ""
            && request.resource.data.proofFileName == ""
            && request.resource.data.proofUrl == "")
        )
        && request.resource.data.createdAt == request.time;
    }

    function isValidTokenRequestReview(requestId) {
      return isAdmin()
        && resource.data.status == "pending"
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "adminNote", "reviewedAt", "reviewedBy", "verifiedHkdAmount", "promoReviewed"])
        && request.resource.data.status in ["approved", "rejected"]
        && request.resource.data.reviewedAt == request.time
        && (request.resource.data.status == "rejected" || (
          validTokenPricing(resource.data)
          && validManualReview(resource.data, request.resource.data)
          && afterUserDoc(resource.data.uid).data.lastTokenGrantRequestId == requestId
          && afterUserDoc(resource.data.uid).data.tokens == userDoc(resource.data.uid).data.tokens + resource.data.amount
        ))
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.adminNote is string
        && request.resource.data.adminNote.size() <= 500;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          "uid", "email", "displayName", "photoURL", "username", "tokens",
          "role", "phoneNumber", "referralCode", "ageConfirmed", "ageConfirmedAt",
          "createdAt", "updatedAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && (
          (("email" in request.auth.token) && request.resource.data.email == request.auth.token.email)
          || (!("email" in request.auth.token) && request.resource.data.email == "")
        )
        && request.resource.data.tokens == 0
        && request.resource.data.role == "user"
        && request.resource.data.username == ""
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 500
        && (
          !("phoneNumber" in request.resource.data)
          || (request.resource.data.phoneNumber is string
            && request.resource.data.phoneNumber.size() <= 24)
        )
        && (
          !("referralCode" in request.resource.data)
          || (request.resource.data.referralCode is string
            && request.resource.data.referralCode.size() <= 40)
        )
        && (
          !("ageConfirmed" in request.resource.data)
          || request.resource.data.ageConfirmed == true
        );
      allow update: if isProfileEdit(uid) ||
        ("lastPurchaseRecordId" in request.resource.data && isTokenSpend(uid)) ||
        ("lastConversionRecordId" in request.resource.data && isCardConversionUserEdit(uid)) ||
        ("lastTokenGrantRequestId" in request.resource.data && isAdminTokenGrant(uid)) ||
        isChatRateLimitUpdate(uid);
    }

    match /usernames/{usernameId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && isValidUsername(request.resource.data.username)
        && usernameId == request.resource.data.username.lower()
        && isValidUsername(afterUserDoc(request.auth.uid).data.username)
        && afterUserDoc(request.auth.uid).data.username.lower() == usernameId
        && (
          hasNoUsername()
          || currentUsername().lower() == usernameId
          || isReleasingCurrentUsername()
          || !ownsUsername(currentUsername())
        );
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["username"])
        && isValidUsername(request.resource.data.username)
        && usernameId == request.resource.data.username.lower();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /tokenRequests/{requestId} {
      allow read: if isAdmin() || isOwner(resource.data.uid);
      allow create: if isValidTokenRequestCreate();
      allow update: if isValidTokenRequestReview(requestId);
      allow delete: if false;
    }

    match /draws/{drawId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();

      match /slots/{slotId} {
        allow read: if true;
        allow create: if isAdmin();
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /rounds/{roundId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();

        match /slots/{slotId} {
          allow read: if true;
          allow create: if isAdmin();
          allow update: if isAdmin() || isValidSlotPurchase(drawId, roundId, slotId);
          allow delete: if isAdmin();
        }
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if isValidRoomMessage(drawId)
          && request.resource.data.source == "draw";
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /cards/{cardId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /publicCardShowcase/{cardId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /drawRecords/{recordId} {
      allow read: if isAdmin() || isOwner(resource.data.uid);
      allow create: if isAdmin() || isMatchingRoundDrawRecord(recordId);
      allow update: if isAdmin() || isCardTokenConversion(recordId) || isShippingRequest();
      allow delete: if false;
    }
  }
}
