rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isSafeImage() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType in [
          "image/jpeg",
          "image/jpg",
          "image/png",
          "image/webp"
        ];
    }

    match /token-proofs/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Proofs are uploaded only by the submitTokenPaymentRequest Cloud Function.
      allow create: if false;
      allow update, delete: if false;
    }

    match /draw-results/{drawId}/{fileName} {
      allow read: if signedIn();
      // Administrative uploads go through an App Check protected Cloud Function.
      allow create, update, delete: if false;
    }
  }
}
