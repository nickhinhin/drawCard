{
  "name": "draw-card",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode beta",
    "dev:admin": "VITE_ADMIN_SITE=true vite --mode beta",
    "build": "vite build --mode beta && node scripts/assert-no-web-admin.mjs",
    "build:admin": "VITE_ADMIN_SITE=true vite build --mode beta --outDir dist-admin",
    "deploy:web": "npm run build && firebase deploy --config firebase.beta-hosting.json --project livedraw-7e3c2 --only hosting:livedraw-7e3c2",
    "deploy:admin": "npm run build:admin && firebase deploy --config firebase.beta-hosting.json --project livedraw-7e3c2 --only hosting:livedraw-adminpage-7e3c2",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "firebase": "^11.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.62.2"
  }
}
